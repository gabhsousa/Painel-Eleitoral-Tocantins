  "views": [
    {
      "viewname": "comparecimento",
      "definition": " SELECT DISTINCT ano,\n    turno,\n    uf,\n    (dados ->> 'CD_ELEICAO'::text) AS eleicao_codigo,\n    (dados ->> 'CD_MUNICIPIO'::text) AS municipio_codigo,\n    (dados ->> 'NM_MUNICIPIO'::text) AS municipio,\n    (dados ->> 'NR_ZONA'::text) AS zona,\n    (dados ->> 'NR_SECAO'::text) AS secao,\n    (dados ->> 'NR_LOCAL_VOTACAO'::text) AS local_codigo,\n    (dados ->> 'CD_CARGO_PERGUNTA'::text) AS cargo_codigo,\n    (dados ->> 'DS_CARGO_PERGUNTA'::text) AS cargo,\n    ((dados ->> 'QT_APTOS'::text))::integer AS aptos,\n    ((dados ->> 'QT_COMPARECIMENTO'::text))::integer AS comparecimento,\n    ((dados ->> 'QT_ABSTENCOES'::text))::integer AS abstencoes,\n    (dados ->> 'DS_SECOES_AGREGADAS'::text) AS secoes_agregadas\n   FROM eleicoes_to.raw_bu;"
    },
    {
      "viewname": "comparecimento_identificado",
      "definition": " SELECT c.ano,\n    c.turno,\n    c.uf,\n    c.eleicao_codigo,\n    c.municipio_codigo,\n    c.municipio,\n    c.zona,\n    c.secao,\n    c.local_codigo,\n    c.cargo_codigo,\n    c.cargo,\n    c.aptos,\n    c.comparecimento,\n    c.abstencoes,\n    c.secoes_agregadas,\n    l.local_codigo AS local_codigo_cadastro,\n    l.local_nome,\n    l.endereco,\n    l.bairro,\n        CASE\n            WHEN (l.secao IS NULL) THEN 'Sem cadastro correspondente'::text\n            WHEN (c.local_codigo <> l.local_codigo) THEN 'Codigo divergente'::text\n            ELSE 'Correspondente'::text\n        END AS situacao_local\n   FROM (eleicoes_to.comparecimento c\n     LEFT JOIN eleicoes_to.locais l ON (((l.ano = c.ano) AND (l.turno = c.turno) AND (l.uf = c.uf) AND (l.municipio_codigo = c.municipio_codigo) AND (l.zona = c.zona) AND (l.secao = c.secao))));"
    },
    {
      "viewname": "locais",
      "definition": " SELECT DISTINCT ano,\n    turno,\n    uf,\n    (dados ->> 'CD_MUNICIPIO'::text) AS municipio_codigo,\n    (dados ->> 'NM_MUNICIPIO'::text) AS municipio,\n    (dados ->> 'NR_ZONA'::text) AS zona,\n    (dados ->> 'NR_SECAO'::text) AS secao,\n    (dados ->> 'NR_LOCAL_VOTACAO'::text) AS local_codigo,\n    (dados ->> 'NM_LOCAL_VOTACAO'::text) AS local_nome,\n    (dados ->> 'DS_ENDERECO'::text) AS endereco,\n    (dados ->> 'NM_BAIRRO'::text) AS bairro,\n    (dados ->> 'NR_LATITUDE'::text) AS latitude,\n    (dados ->> 'NR_LONGITUDE'::text) AS longitude,\n    (dados ->> 'DS_TIPO_SECAO_AGREGADA'::text) AS tipo_secao,\n    (dados ->> 'NR_SECAO_PRINCIPAL'::text) AS secao_principal\n   FROM eleicoes_to.raw_locais;"
    },
    {
      "viewname": "resumo_locais",
      "definition": " WITH nomes AS (\n         SELECT DISTINCT locais.ano,\n            locais.turno,\n            locais.uf,\n            locais.municipio_codigo,\n            locais.zona,\n            locais.local_codigo,\n            locais.local_nome,\n            locais.endereco,\n            locais.bairro\n           FROM eleicoes_to.locais\n        )\n SELECT c.ano,\n    c.turno,\n    c.uf,\n    c.eleicao_codigo,\n    c.municipio_codigo,\n    c.municipio,\n    c.zona,\n    c.local_codigo,\n    n.local_nome,\n    n.endereco,\n    n.bairro,\n    c.cargo_codigo,\n    c.cargo,\n    count(*) AS secoes_totalizadas,\n    sum(c.aptos) AS aptos,\n    sum(c.comparecimento) AS comparecimento,\n    sum(c.abstencoes) AS abstencoes,\n    round(((100.0 * (sum(c.abstencoes))::numeric) / (NULLIF(sum(c.aptos), 0))::numeric), 2) AS percentual_abstencao\n   FROM (eleicoes_to.comparecimento c\n     LEFT JOIN nomes n USING (ano, turno, uf, municipio_codigo, zona, local_codigo))\n  GROUP BY c.ano, c.turno, c.uf, c.eleicao_codigo, c.municipio_codigo, c.municipio, c.zona, c.local_codigo, n.local_nome, n.endereco, n.bairro, c.cargo_codigo, c.cargo;"
    },
    {
      "viewname": "resumo_locais_cadastro",
      "definition": " SELECT ano,\n    turno,\n    uf,\n    eleicao_codigo,\n    municipio_codigo,\n    municipio,\n    zona,\n    local_codigo_cadastro,\n    local_nome,\n    endereco,\n    bairro,\n    cargo_codigo,\n    cargo,\n    count(*) AS secoes_totalizadas,\n    count(*) FILTER (WHERE (situacao_local = 'Codigo divergente'::text)) AS secoes_codigo_divergente,\n    sum(aptos) AS aptos,\n    sum(comparecimento) AS comparecimento,\n    sum(abstencoes) AS abstencoes,\n    round(((100.0 * (sum(abstencoes))::numeric) / (NULLIF(sum(aptos), 0))::numeric), 2) AS percentual_abstencao\n   FROM eleicoes_to.comparecimento_identificado\n  GROUP BY ano, turno, uf, eleicao_codigo, municipio_codigo, municipio, zona, local_codigo_cadastro, local_nome, endereco, bairro, cargo_codigo, cargo;"
    },
    {
      "viewname": "votacao",
