{
  "name": "consulta-eleitoral-to",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start:prod": "node build/server/index.js",
    "test:security": "node --env-file=.env --import tsx --test scripts/security.test.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "fastify": "^5.0.0",
    "leaflet": "^1.9.4",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
